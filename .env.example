# Banco de dados (SQLite em dev; PostgreSQL em produção)
DATABASE_URL="file:./dev.db"

# Segredo para assinatura de cookies de fluxo (OBRIGATÓRIO em produção)
COOKIE_SECRET=""

# Twilio Verify — SOMENTE no servidor. Sem estes valores, o app roda em
# modo simulado de desenvolvimento (código aparece no log do servidor).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# E-mail transacional (opcional em dev; código aparece no log do servidor)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="acesso@scrutiniums.com"
