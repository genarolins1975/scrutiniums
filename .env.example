# Banco de dados (PGlite em dev; PostgreSQL em produção). Três formatos:
# 1. Produção (Postgres gerenciado — Neon/Supabase/Vercel):
#    DATABASE_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"
#    (com sslmode=require ou PGSSL=1, o TLS é habilitado no driver pg)
# 2. Dev local com PGlite em diretório customizado:
#    DATABASE_URL="pglite://./.pglite"
# 3. Dev local padrão: deixe vazio (ou omita) — PGlite persiste em ./.pglite
DATABASE_URL=""

# Segredo para assinatura de cookies de fluxo (OBRIGATÓRIO em produção)
COOKIE_SECRET=""

# Códigos de acesso antecipado, separados por vírgula (ex.: "SCRUT-2026,CONVIDADO-01").
# Comparação case-insensitive com trim. Vazio ou ausente → nenhum código é
# válido: quem completar o perfil vai para a lista de espera (WAITLIST).
ACCESS_CODES=""

# Twilio Verify — SOMENTE no servidor. Sem estes valores, o app roda em
# modo simulado de desenvolvimento (código aparece no log do servidor).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# E-mail transacional via Resend (obrigatório em produção; em dev,
# sem a chave, o código aparece no log do servidor)
RESEND_API_KEY=""
MAIL_FROM="Scrutiniums <acesso@scrutiniums.com>"

# Segredo do disparo do boletim mensal (POST /api/boletim/enviar), usado
# pelo workflow boletim-mensal.yml via header "Authorization: Bearer …".
# Mínimo de 16 caracteres; vazio → só administradores logados disparam.
BOLETIM_SECRET=""

# Administradores da plataforma: e-mails separados por vírgula
# (comparação case-insensitive, com trim). Vazio ou ausente → ninguém é
# admin; /app/admin responde 404 e o envio de convites fica bloqueado.
# ADMIN_EMAILS="dono@scrutiniums.com"
ADMIN_EMAILS=""
