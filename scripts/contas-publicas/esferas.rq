PREFIX loa: <http://vocab.e.gov.br/2013/09/loa#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?cod ?nome ?data (SUM(?a) AS ?inicial) (SUM(?b) AS ?atualizada) (SUM(?c) AS ?empenhado) (SUM(?d) AS ?liquidado) (SUM(?e) AS ?pago) WHERE { GRAPH <http://orcamento.dados.gov.br/2025/> { ?i loa:temEsfera ?s; loa:temExercicio ?ex; loa:valorDotacaoInicial ?a; loa:valorLeiMaisCredito ?b; loa:valorEmpenhado ?c; loa:valorLiquidado ?d; loa:valorPago ?e. ?s loa:codigo ?cod; rdfs:label ?nome. ?ex loa:dataUltimaAtualizacao ?data. }} GROUP BY ?cod ?nome ?data