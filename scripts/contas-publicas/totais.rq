PREFIX loa: <http://vocab.e.gov.br/2013/09/loa#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?cod ?data (COUNT(DISTINCT ?i) AS ?itens) (COUNT(?a) AS ?cobertura) (COUNT(?b) AS ?coberturaAtualizada) (COUNT(?c) AS ?coberturaEmpenhado) (COUNT(?d) AS ?coberturaLiquidado) (COUNT(?e) AS ?coberturaPago) (SUM(?a) AS ?inicial) (SUM(?b) AS ?atualizada) (SUM(?c) AS ?empenhado) (SUM(?d) AS ?liquidado) (SUM(?e) AS ?pago) WHERE { GRAPH <http://orcamento.dados.gov.br/YEAR/> { ?i loa:temEsfera ?s; loa:temExercicio ?ex. ?s loa:codigo ?cod. FILTER (?cod IN ("10","20")) ?ex loa:dataUltimaAtualizacao ?data. OPTIONAL {?i loa:valorDotacaoInicial ?a} OPTIONAL {?i loa:valorLeiMaisCredito ?b} OPTIONAL {?i loa:valorEmpenhado ?c} OPTIONAL {?i loa:valorLiquidado ?d} OPTIONAL {?i loa:valorPago ?e} }} GROUP BY ?cod ?data ORDER BY ?cod
