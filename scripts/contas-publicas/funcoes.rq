PREFIX loa: <http://vocab.e.gov.br/2013/09/loa#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?funcao ?nomeFuncao ?subfuncao ?nomeSubfuncao ?rp (COUNT(DISTINCT ?i) AS ?itens) (COUNT(?a) AS ?cobertura) (COUNT(?b) AS ?coberturaAtualizada) (COUNT(?c) AS ?coberturaEmpenhado) (COUNT(?d) AS ?coberturaLiquidado) (COUNT(?e) AS ?coberturaPago) (SUM(?a) AS ?inicial) (SUM(?b) AS ?atualizada) (SUM(?c) AS ?empenhado) (SUM(?d) AS ?liquidado) (SUM(?e) AS ?pago) WHERE { GRAPH <http://orcamento.dados.gov.br/YEAR/> { ?i loa:temEsfera ?s; loa:temFuncao ?fu; loa:temSubfuncao ?su. ?s loa:codigo ?esfera. FILTER (?esfera IN ("10","20")) ?fu loa:codigo ?funcao; rdfs:label ?nomeFuncao. ?su loa:codigo ?subfuncao; rdfs:label ?nomeSubfuncao. OPTIONAL { ?i loa:temResultadoPrimario ?r. ?r loa:codigo ?rp } OPTIONAL {?i loa:valorDotacaoInicial ?a} OPTIONAL {?i loa:valorLeiMaisCredito ?b} OPTIONAL {?i loa:valorEmpenhado ?c} OPTIONAL {?i loa:valorLiquidado ?d} OPTIONAL {?i loa:valorPago ?e} }} GROUP BY ?funcao ?nomeFuncao ?subfuncao ?nomeSubfuncao ?rp ORDER BY ?funcao ?subfuncao ?rp
